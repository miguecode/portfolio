---
// Technology's data
import {
  technologysDataOne,
  technologysDataTwo,
} from "../data/technologysData";

// Component
import SkillsGroup from "./SkillsGroup.astro";

const lang = Astro.currentLocale || 'es';
const backendTitle = lang === 'en' ? 'Backend & Tools' : 'Backend y Complementos';
---

<div
  class="section-child flex flex-col container-highlight
  gap-y-6 py-5 px-3 mt-6 mx-auto"
>
  <SkillsGroup skills={technologysDataOne} title="Frontend" />
  <SkillsGroup skills={technologysDataTwo} title={backendTitle} />
</div>
