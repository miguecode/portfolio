---
// Component
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";

// Icon
import HamburgerIcon from "../icons/Hamburger.astro";
import CloseIcon from "../icons/Close.astro";

const lang = Astro.currentLocale || 'es';

// Navbar items
const navItems = {
  es: [
    { title: "Inicio", label: "inicio", href: "#inicio" },
    { title: "Experiencia", label: "Experiencia", href: "#experiencia" },
    { title: "Proyectos", label: "proyectos", href: "#proyectos" },
    { title: "Habilidades", label: "habilidades", href: "#habilidades" },
    { title: "Sobre mí", label: "sobre-mi", href: "#sobre-mi" },
    { title: "Contacto", label: "contacto", href: "#contacto" },
  ],
  en: [
    { title: "Home", label: "home", href: "#home" },
    { title: "Experience", label: "Experience", href: "#experience" },
    { title: "Projects", label: "projects", href: "#projects" },
    { title: "Skills", label: "skills", href: "#skills" },
    { title: "About", label: "about", href: "#about" },
    { title: "Contact", label: "contact", href: "#contact" },
  ]
};

const itemsToRender = (navItems)[lang as "es" | "en"];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center md:w-full mx-auto mt-2 right-0 lg:px-0 px-4"
>
  <!-- Hamburger Menu -->
  <nav class="md:hidden w-full mr-5">
    <div class="relative flex justify-end">
      <div
        id="hamburger-icon"
        class="cursor-pointer 
        bg-white dark:bg-navbar-dark-bg
          border rounded-lg border-gray-300 dark:border-gray-700
          shadow-[0_3px_10px_rgb(0,0,0,0.2)]
          p-2
        text-slate-800 dark:text-slate-300
        hover:text-navbar-primary dark:hover:text-navbar-secondary
        active:bg-slate-100 dark:active:bg-slate-700
          transition"
      >
        <HamburgerIcon class="size-8" />
      </div>
    </div>
    <div
      id="menu-links"
      class="hidden flex-col items-center
        border rounded-md
        absolute top-0 right-0 mr-5
      bg-white/90 dark:bg-navbar-dark-bg
      border-gray-100 dark:border-gray-500/20
        shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md"
    >
      <div
        id="close-icon"
        class="cursor-pointer
          p-2 mb-2 self-end
        text-slate-800 dark:text-slate-400
        hover:text-slate-500 dark:hover:text-slate-300
          transition"
      >
        <CloseIcon class="size-8" />
      </div>
      {
        itemsToRender.map((link) => (
          <a
            class="px-8 py-2 
              rounded-lg
              flex justify-start text-start
            hover:text-navbar-primary dark:hover:text-navbar-secondary
              font-bold"
            aria-label={link.label}
            href={link.href}
            tabindex="0"
          >
            {link.title}
          </a>
        ))
      }
      <!-- Controls will be moved here in mobile view -->
    </div>
  </nav>

  <!-- Desktop Navbar -->
  <nav
    id="desktop-navbar"
    class="hidden md:flex justify-center items-center min-w-fit
      lg:px-12 px-8 gap-4 mt-2 rounded-full font-bold lg:mx-0 mx-4
    text-gray-600 dark:text-gray-200"
  >
    {
      itemsToRender.map((link, index) => (
        <a
          class="relative block px-2 py-2 transition text-center
          hover:text-navbar-primary dark:hover:text-navbar-secondary"
          aria-label={link.label}
          href={link.href}
          style={`animation-delay: ${index * 0.1}s`}
          tabindex="0"
        >
          {link.title}
        </a>
      ))
    }
    
    <!-- We group toggles to move them together -->
    <div id="navbar-controls" class="flex items-center gap-2">
      <ThemeToggle />
      <LanguageToggle />
    </div>
  </nav>
</header>

<style>
  /* Navbar animation */
  #desktop-navbar {
    @apply bg-white/90 dark:bg-navbar-dark-bg;
    animation: nav-shadown 2s linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    0% {
      @apply bg-transparent;
    }
    100% {
      @apply shadow-lg backdrop-blur;
    }
  }

  /* Hamburger Menu Links Animation */
  #menu-links {
    animation: scale-up-center .1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.99);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<!-- Navbar items color change, hamburger menu functions and controls container position -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    // Function to add/remove active classes from nav items
    const activateNavItem = (id: any) => {
      navItems.forEach((item) => {
        // Check if href is an anchor link like '#id'
        const href = item.getAttribute("href");
        if ((href === `#${id}` || href?.endsWith(`#${id}`)) && window.innerWidth >= 768) {
          item.classList.add("text-navbar-primary", "dark:text-navbar-secondary");
        } else {
          item.classList.remove("text-navbar-primary", "dark:text-navbar-secondary");
        }
      });
    };

    // Create a single observer to handle all sections
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activateNavItem(entry.target.id);
          }
        });
      },
      {
        rootMargin: "-45% 0px -70% 0px",
      }
    );

    // Observe all sections
    sections.forEach((section) => observer.observe(section));

    // Optimization: Stop observing when the tab is not visible
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => observer.observe(section));
      }
    });

    ////////////////////////////////////////////////////////////////////////
    // Open or close the Hamburger Menu (Mobile Navbar)
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const menuLinks = document.getElementById("menu-links");

    const showMenu = () => {
      hamburgerIcon?.classList.add("hidden");
      menuLinks?.classList.remove("hidden");
      menuLinks?.classList.add("flex");
    };

    const hideMenu = () => {
      hamburgerIcon?.classList.remove("hidden");
      menuLinks?.classList.add("hidden");
    };

    hamburgerIcon?.addEventListener("click", (e) => {
      e.stopPropagation();
      showMenu();
    });

    closeIcon?.addEventListener("click", hideMenu);

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!menuLinks?.contains(target) && !hamburgerIcon?.contains(target)) {
        hideMenu();
      }
    });

    // --- Click Handling for instant feedback ---
    navItems.forEach((item) => {
      item.addEventListener("click", () => {
        let id = item.getAttribute("href") ?? "";
        if (id.includes("#")) {
          id = id.split("#")[1];
        }
        activateNavItem(id);
        if (window.innerWidth < 768) {
          hideMenu();
        }
      });
    });

    ////////////////////////////////////////////////////////////////////////
    // Change the Controls Container position in the page (Theme & Language)
    const navbarControls = document.getElementById("navbar-controls");
    const desktopMenu = document.getElementById("desktop-navbar");

    const moveControls = () => {
      if (window.innerWidth >= 768) {
        // Move to desktop navbar
        if (!desktopMenu?.contains(navbarControls) && navbarControls) {
          desktopMenu?.appendChild(navbarControls);
        }
      } else {
        // Move to mobile menu
        if (!menuLinks?.contains(navbarControls) && navbarControls) {
          navbarControls.classList.add("pb-4", "pt-2");
          menuLinks?.appendChild(navbarControls);
        } else if (navbarControls) {
          navbarControls.classList.remove("pb-4", "pt-2");
        }
      }
    };

    moveControls();
    window.addEventListener("resize", moveControls);
  });
</script>
