---
import LanguageIcon from "../icons/Language.astro";
const isEn = Astro.currentLocale === 'en';
---

<div id="language-toggle-component" class="relative ml-1 mr-1 flex items-center text-slate-800 dark:text-slate-300">
  <button
    id="lang-toggle-btn"
    class="border-none flex items-center gap-1 hover:scale-110 transition px-1 py-1 hover:text-navbar-primary dark:hover:text-navbar-secondary"
    aria-label="Cambiar idioma / Change language"
  >
    <LanguageIcon class="size-5" />
    <span id="lang-text" class="text-sm font-bold uppercase">{isEn ? 'en' : 'es'}</span>
  </button>
</div>

<script is:inline>
  document.getElementById("lang-toggle-btn")?.addEventListener("click", () => {
    const isEn = window.location.pathname.startsWith("/en");
    const newLang = isEn ? "es" : "en";
    localStorage.setItem("lang", newLang);
    window.location.replace(isEn ? "/" : "/en");
  });
</script>
